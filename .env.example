# Headless WordPress CMS
WP_API_URL="https://gomowebb.com/wow-backend"

# Shared secret WordPress sends as x-wow-secret when calling /api/revalidate.
REVALIDATE_SECRET=""

# Public site URL, used to resolve relative og:image paths.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase (newsletter signup) — carried over from the Lovable original.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Languages the site serves, default first (served at /); others at /<code>/.
# Add a code after adding the language in WPML › Languages. Default: "sv,en".
NEXT_PUBLIC_SITE_LANGUAGES="sv,en"
